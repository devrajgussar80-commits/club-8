{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kalakriti-store",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev", "--prefix", "D:/New folder/kalakriti/frontend"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "kalakriti-api",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "start", "--prefix", "D:/New folder/kalakriti/backend"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8123"],
      "port": 8123,
      "autoPort": false
    }
  ]
}
